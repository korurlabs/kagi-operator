    "/kagi/auth/kubernetes/exchange": {
      "post": {
        "deprecated": true,
        "description": "Deprecated: use exchangeToken (POST /kagi/auth/token) with one resource per app environment. This alias serves released operator and kagi-init builds: it resolves the organization from the cluster issuer URL and grants the full scopes of the one workload role whose Kubernetes rule matches the service account (409 KGI_STA_047 when several do).",
        "operationId": "exchangeWorkloadToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KagiWorkloadTokenExchangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KagiWorkloadTokenExchangeResponse"
                }
              }
            },
            "description": "Token exchanged successfully"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/KagiProblem"
                }
              }
            },
            "description": "Missing or blank service account token"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/KagiProblem"
                }
              }
            },
            "description": "Token exchange denied (untrusted issuer, invalid signature, wrong audience, expired, or no matching binding)"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/KagiProblem"
                }
              }
            },
            "description": "More than one enabled workload role has a Kubernetes rule on this cluster that matches the service account (KGI_STA_047, with the role ids). Overlapping rules need an admin's attention"
          },
          "4XX": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Exchange a kubernetes service account token for a scoped Kagi access token",
        "tags": [
          "trust"
        ],
        "x-kagi-clients": [
          "operator"
        ]
      }
    },
    "/kagi/auth/token": {
      "post": {
        "description": "RFC 8693 token exchange. The workload sends its platform token (Kubernetes service account, CI job, cloud identity) or a machine assertion and one resource per (app, environment) it is about to read. The organization is the apps' organization. Kagi verifies the token against that organization's identity sources, finds the enabled workload roles whose trust rules match the identity, and grants through the one role that covers every requested pair; the token's scope is exactly the requested pairs. The workload never names a role. The subject token's audience is the API host (api.kagi.pw in production) unless the source overrides it. Errors are RFC 9457 Problem Details, not RFC 6749 error objects.",
        "operationId": "exchangeToken",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "encoding": {
                "resource": {
                  "explode": true,
                  "style": "form"
                }
              },
              "schema": {
                "$ref": "#/components/schemas/TokenExchangeForm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenExchangeResponse"
                }
              }
            },
            "description": "Token issued. Read the secrets with GET /kagi/apps/{appId}/environments/{environmentSlug}/secrets/fetch and the minted token"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/KagiProblem"
                }
              }
            },
            "description": "Malformed exchange (KGI_VAL_217): an unsupported grant_type or subject_token_type; no resource, more than 32, or one that is not an absolute https URI on the API host with the path /kagi/apps/<uuid>/environments/<slug>; an audience or scope parameter; requested_token_ttl outside 60 to 3600"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/KagiProblem"
                }
              }
            },
            "description": "Exchange denied (KGI_AUT_003), deliberately opaque: an unknown app id or apps of two organizations; no enabled source of the organization accepts the token; an invalid signature, a wrong or multi-valued audience, a missing sub or a token too old; no enabled role trusts the identity; the caller's address is outside every trusting role's CIDR list; or no single usable role covers every requested pair. Once the token's signature verified against one of the organization's sources, the refusal is recorded for its admins (listWorkloadExchangeDenials)"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/KagiProblem"
                }
              }
            },
            "description": "Identity verified and a role covers the request, but the organization's plan does not include workload identity or the secrets library (KGI_SEC_062), or its subscription is locked (KGI_SEC_005)"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/KagiProblem"
                }
              }
            },
            "description": "Too many exchanges from this address or for this organization (KGI_SEC_063); retry later"
          },
          "4XX": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Exchange a workload's platform token for a Kagi token that reads the requested app environments",
        "tags": [
          "trust"
        ],
        "x-kagi-clients": [
          "external",
          "cli",
          "operator"
        ],
        "x-spring-provide-args": [
          "jakarta.servlet.http.HttpServletRequest httpRequest"
        ]
      }
    },
    "/kagi/certificates/by-id/{certificateId}/tls": {
      "get": {
        "description": "Fetches decrypted TLS content for the certificate addressed by its stable id. The id is durable across renames and folder moves, so this is the machine fetch contract operators bind to after resolving a node path to an id once.",
        "operationId": "fetchCertificateTls",
        "parameters": [
          {
            "in": "path",
            "name": "certificateId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateEntry"
                }
              }
            },
            "description": "Certificate TLS content fetched"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/KagiProblem"
                }
              }
            },
            "description": "Unauthorized -- authentication required (missing or invalid JWT/PAT)"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/KagiProblem"
                }
              }
            },
            "description": "Forbidden -- caller lacks VIEWER+ on the certificate; or the caller is a member without a license in a METERED, TRIAL_ENDED or LAPSED organization (KGI_SEC_053, with organizationId, tier and revokedAt)"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/KagiProblem"
                }
              }
            },
            "description": "Certificate not found"
          },
          "4XX": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Fetch kagi certificate TLS content by id",
        "tags": [
          "certificate"
        ],
        "x-kagi-clients": [
          "operator"
        ],
        "x-spring-provide-args": [
          "@com.sensey.kagi.oba.security.annotation.GetUser com.sensey.kagi.domain.identity.entity.KagiUser user"
        ]
      }
    },
    "/kagi/folders/certificates/resolve/{path}": {
      "get": {
        "description": "Resolves the certificate addressed by path (folder segments then the certificate slug) to its stable id and display name. The id is the durable machine binding used to fetch TLS content by id thereafter.",
